{
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/patients", "destination": "/api/patients" },
    { "source": "/api/notes", "destination": "/api/notes" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}